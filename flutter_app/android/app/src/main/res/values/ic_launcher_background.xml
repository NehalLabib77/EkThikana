<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background colour for Gochano.

  Matches the dominant background hue of the master artwork
  (flutter_app/assets/branding/gochano1.png) so the foreground
  layer blends seamlessly when the launcher clips the adaptive
  icon to its shape (circle, squircle, teardrop, etc.).

  Kept in sync with the sampled background of gochano1.png.
  Defining it as a colour resource lets us reuse the same hue
  across light / dark adaptive variants and themed icons
  (Android 13+).
-->
<resources>
    <color name="ic_launcher_background">#B3F1ED</color>
</resources>