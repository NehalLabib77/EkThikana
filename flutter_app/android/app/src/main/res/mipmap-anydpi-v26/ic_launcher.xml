<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon for Android 8+ (API 26+).

  Older devices (API 24, 25) continue to use the raster
  mipmap-*/ic_launcher.png fallback; this XML takes over on every
  device that supports the adaptive icon system.

  Layers:
    * background: light teal from @color/ic_launcher_background
      (matched to gochano1.png's dominant background hue)
    * foreground: raster gochano1.png from @drawable/ic_launcher_foreground
      (density-specific PNGs in drawable-*/ic_launcher_foreground.png)

  The launcher masks each layer to its own shape (circle, square,
  squircle, teardrop, etc.) so the same artwork renders correctly
  on every device.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>