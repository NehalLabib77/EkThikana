rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStudent() {
      return verified() && userDoc().data.role == 'student';
    }

    function isGroupMember(groupId) {
      return isStudent()
        && groupId is string
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function canReadStudyDoc(data) {
      return isStudent() && (
        data.ownerId == request.auth.uid
        || data.visibility == 'public'
        || (data.visibility == 'group' && isGroupMember(data.groupId))
      );
    }

    function ownedCreate() {
      return verified() && request.resource.data.ownerId == request.auth.uid;
    }

    function ownedReadDelete() {
      return verified() && resource.data.ownerId == request.auth.uid;
    }

    function ownedUpdate() {
      return verified()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    // -------- PART 3 helpers --------
    function isGroupAdmin(groupId) {
      return isStudent()
        && groupId is string
        && (
          request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
          || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds
        );
    }

    function groupHasChatEnabled(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.chatEnabled == true;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['student', 'general'];

      allow read: if verified() && request.auth.uid == uid;

      allow update: if verified()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      allow delete: if verified() && request.auth.uid == uid;

      match /saved_materials/{materialId} {
        allow read, write: if verified() && request.auth.uid == uid;
      }

      match /material_state/{materialId} {
        allow read, write: if verified() && request.auth.uid == uid;

        match /page_notes/{noteId} {
          allow read, write: if verified() && request.auth.uid == uid;
        }
      }

      // PART 3: monthly budget per user per monthKey (YYYY-MM)
      match /monthly_budget/{monthKey} {
        allow read, write: if verified() && request.auth.uid == uid;
      }

      // PART 3: focus / pomodoro sessions per user
      match /focus_sessions/{focusId} {
        allow read, write: if verified() && request.auth.uid == uid;
      }

      // PART 3: locally-downloaded materials per user
      match /offline_materials/{materialId} {
        allow read, write: if verified() && request.auth.uid == uid;
      }
    }

    // ---------------- STUDENT-ONLY ACADEMIC DATA ----------------

    match /semesters/{id} {
      allow create: if isStudent() && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if isStudent() && resource.data.ownerId == request.auth.uid;
      allow update: if isStudent()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /subjects/{id} {
      allow create: if isStudent() && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if isStudent() && resource.data.ownerId == request.auth.uid;
      allow update: if isStudent()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /notes/{id} {
      allow create: if isStudent()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility in ['private', 'group', 'public'];
      allow read: if canReadStudyDoc(resource.data);
      allow update, delete: if isStudent()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /materials/{id} {
      allow read: if canReadStudyDoc(resource.data);
      allow create, update, delete: if false; // trusted backend only
    }

    match /groups/{id} {
      allow read: if isStudent() && request.auth.uid in resource.data.memberIds;
      allow create, update, delete: if false; // trusted backend only

      match /projects/{projectId} {
        // Any group member can read projects
        allow read: if isGroupMember(id) || isGroupAdmin(id);

        // Only admins can create, update, or delete projects
        allow create, update, delete: if isGroupAdmin(id);

        match /tasks/{taskId} {
          // Any group member can read tasks
          allow read: if isGroupMember(id) || isGroupAdmin(id);

          // Only admins can create or delete tasks
          allow create, delete: if isGroupAdmin(id);

          // Admins or the assigned user can update tasks (toggle complete, reassign, set reminder)
          allow update: if isStudent() && (
            isGroupAdmin(id)
            || resource.data.assigneeId == request.auth.uid
          );
        }
      }
    }

    // ---------------- STUDENT + GENERAL PERSONAL DATA ----------------

    match /tasks/{id} {
      allow create: if ownedCreate();
      allow read, delete: if ownedReadDelete();
      // PART 3: owner can flip `completed` and `completedAt` without rewriting
      // ownerId (ownedUpdate already enforces ownerId immutability).
      allow update: if ownedUpdate();
    }

    // PART 3: group chat messages. Membership is mandatory; chatEnabled is a
    // write gate controlled by the group admin via the trusted backend.
    match /group_messages/{msgId} {
      allow read: if isGroupMember(resource.data.groupId);

      allow create: if isStudent()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.groupId is string
        && isGroupMember(request.resource.data.groupId)
        && groupHasChatEnabled(request.resource.data.groupId);

      // Author can delete their own message; admin can delete any in their group.
      allow delete: if isStudent()
        && (resource.data.senderId == request.auth.uid
            || isGroupAdmin(resource.data.groupId));

      // Edits are not part of the product surface.
      allow update: if false;
    }

    match /medicines/{id} {
      allow create: if ownedCreate();
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate();
    }

    match /medicine_doses/{id} {
      allow create: if ownedCreate()
        && request.resource.data.status in ['pending', 'taken', 'skipped', 'missed'];
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate()
        && request.resource.data.status in ['pending', 'taken', 'skipped', 'missed'];
    }

    match /bazar_items/{id} {
      allow create: if ownedCreate();
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate();
    }

    match /daily_expenses/{id} {
      allow create: if ownedCreate() && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
    }

    match /commute_trips/{id} {
      allow create: if ownedCreate()
        && request.resource.data.actualFare is number
        && request.resource.data.actualFare > 0;
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate()
        && request.resource.data.actualFare is number
        && request.resource.data.actualFare > 0;
    }

    // Central expense ledger. IDs are deterministic by source + sourceRecordId.
    match /financial_transactions/{id} {
      allow create: if verified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type == 'expense'
        && request.resource.data.source in ['daily', 'bazar', 'medicine', 'commute']
        && request.resource.data.sourceRecordId is string
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;

      allow read: if verified() && resource.data.ownerId == request.auth.uid;

      // Deleting a mirror row that was never written must be a no-op, not a
      // denial. A bazar item added but not yet purchased, and a dose marked
      // skipped or missed, both clear a mirror row that may never have
      // existed -- and because that delete rides in the same batch as the
      // item write, a denial here rejected the *whole batch*. The student
      // could not add an unpurchased item or skip a dose at all, and the
      // failure surfaced as "You do not have access to this item".
      //
      // Permitting a delete when `resource == null` grants nothing: there is
      // no document to remove and no data to read.
      allow delete: if verified()
        && (resource == null || resource.data.ownerId == request.auth.uid);

      allow update: if verified()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == 'expense'
        && request.resource.data.source in ['daily', 'bazar', 'medicine', 'commute']
        && request.resource.data.sourceRecordId == resource.data.sourceRecordId
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;
    }

    // Backend-only metering/moderation.
    match /ai_usage/{id} {
      allow read, write: if false;
    }

    match /upload_usage/{id} {
      allow read, write: if false;
    }

    match /reports/{id} {
      allow read, write: if false;
    }

    // Legacy LifeHub/finance collections (FamilyHub/RentMate/Wellness/old grocery/location/savings
    // stores) intentionally have no match rules and are therefore denied.
  }
}