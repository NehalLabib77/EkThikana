rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Phase 10.6: analytics are backend-only aggregate events. Students and
    // normal clients must never read platform-wide activity or write events.
    match /analytics_events/{eventId} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && (
        request.auth.token.email_verified == true
        || request.auth.token.telecom_verified == true
      );
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStudent() {
      return verified() && userDoc().data.role == 'student';
    }

    function isGroupMember(groupId) {
      return isStudent()
        && groupId is string
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function canReadStudyDoc(data) {
      return isStudent() && (
        data.ownerId == request.auth.uid
        || data.visibility == 'public'
        || (data.visibility == 'group' && isGroupMember(data.groupId))
      );
    }

    // Phase 10 content is written by the trusted backend and keyed by the
    // authenticated student's id inside the document.
    match /ai_content/{contentId} {
      allow read: if isStudent() && resource.data.studentId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Phase 10.5: derived long-term learning memory and recommendations.
    match /learning_memory/{studentId} {
      allow read: if isStudent() && studentId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /content_effectiveness/{contentId} {
      allow read: if isStudent() && resource.data.studentId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /learning_recommendations/{studentId} {
      allow read: if isStudent() && studentId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Phase 12: Ziku Socratic Tutor sessions and turns.
    match /tutor_sessions/{sessionId} {
      allow read: if isStudent() && (resource.data.studentId == request.auth.uid || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;

      match /turns/{turnId} {
        allow read: if isStudent() && (
          get(/databases/$(database)/documents/tutor_sessions/$(sessionId)).data.studentId == request.auth.uid
          || get(/databases/$(database)/documents/tutor_sessions/$(sessionId)).data.uid == request.auth.uid
        );
        allow create, update, delete: if false;
      }
    }

    function ownedCreate() {
      return verified() && request.resource.data.ownerId == request.auth.uid;
    }

    function ownedReadDelete() {
      return verified() && resource.data.ownerId == request.auth.uid;
    }

    function ownedUpdate() {
      return verified()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    // -------- PART 3 helpers --------
    function isGroupAdmin(groupId) {
      return isStudent()
        && groupId is string
        && (
          request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
          || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds
        );
    }

    function groupHasChatEnabled(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.chatEnabled == true;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['student', 'general'];

      allow read: if verified() && request.auth.uid == uid;

      allow update: if verified()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      allow delete: if verified() && request.auth.uid == uid;

      match /saved_materials/{materialId} {
        allow read, write: if verified() && request.auth.uid == uid;
      }

      match /material_state/{materialId} {
        allow read, write: if verified() && request.auth.uid == uid;

        match /page_notes/{noteId} {
          allow read, write: if verified() && request.auth.uid == uid;
        }
      }

      // PART 3: monthly budget per user per monthKey (YYYY-MM)
      match /monthly_budget/{monthKey} {
        allow read, write: if verified() && request.auth.uid == uid;
      }

      // PART 3: focus / pomodoro sessions per user
      match /focus_sessions/{focusId} {
        allow read, write: if verified() && request.auth.uid == uid;
      }

      // PART 3: locally-downloaded materials per user
      match /offline_materials/{materialId} {
        allow read, write: if verified() && request.auth.uid == uid;
      }

      // Phase 3C: quiz results per user
      match /quiz_results/{quizId} {
        allow create: if isStudent() && request.auth.uid == uid;
        allow read, delete: if isStudent() && request.auth.uid == uid;
        allow update: if false;
      }

      // Phase 4: AI feedback per user
      match /ai_feedback/{feedbackId} {
        allow create: if isStudent() && request.auth.uid == uid;
        allow read: if isStudent() && request.auth.uid == uid;
        allow update, delete: if false;
      }

      // Phase T4: Exam Rescue sessions per user
      match /exam_rescue/{sessionId} {
        allow read, write: if verified() && request.auth.uid == uid;
      }

      // Phase 1: AI mistake memory per user. Capture, the Ziku analysis and
      // the review ladder all run on the trusted backend (admin SDK bypasses
      // these rules); the client only ever reads its own records.
      match /mistakes/{mistakeId} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      // Phase 2: Academic Health daily snapshots. Written and recomputed by
      // the trusted backend only, so a client can never inflate its own
      // score or rewrite yesterday's trend point.
      match /health_history/{dayKey} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      // Phase 4: Study Coach caches (learning profile, daily mission, weekly
      // report). Pure derived advice - the backend is the only writer so a
      // client can never hand itself a kinder recommendation, and a student
      // only reads their own.
      match /learning_profiles/{docId} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /daily_coach_recommendations/{dayKey} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /weekly_reports/{weekKey} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      // Phase 8: Ziku Personal Intelligence caches (Learning Journey, daily
      // brief, learning personality, next best action, achievement stamps).
      // Pure derived memory of the student's own history - the trusted
      // backend is the only writer so a client can never hand itself a
      // better trend, a kinder brief or an earned stamp, and a student only
      // ever reads their own.
      match /learning_journeys/{dayKey} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /ziku_briefs/{dayKey} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /learning_personalities/{docId} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /next_best_actions/{dayKey} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /learning_achievements/{docId} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      // Phase 9: Adaptive Learning Engine caches. These are derived from
      // Mistake Memory, Academic Health and quiz history; only the trusted
      // backend writes them.
      match /adaptive_revision/{dayKey} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /adaptive_curriculum/{dayKey} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /adaptive_textbooks/{docId} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /adaptive_learning_paths/{docId} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      // Phase 3: Real Exam Simulator. Papers, attempts and results are all
      // graded by the trusted backend (admin SDK bypasses these rules), so a
      // student can read its own exam hall data but never rewrite a score,
      // an attempt's answers or a result. The per-exam question paper lives
      // under the exam document.
      match /exams/{examId} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
        match /exam_questions/{index} {
          allow read: if isStudent() && request.auth.uid == uid;
          allow create, update, delete: if false;
        }
      }

      match /exam_attempts/{attemptId} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      match /exam_results/{resultId} {
        allow read: if isStudent() && request.auth.uid == uid;
        allow create, update, delete: if false;
      }
    }

    // ---------------- STUDENT-ONLY ACADEMIC DATA ----------------

    match /semesters/{id} {
      allow create: if isStudent() && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if isStudent() && resource.data.ownerId == request.auth.uid;
      allow update: if isStudent()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /subjects/{id} {
      allow create: if isStudent() && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if isStudent() && resource.data.ownerId == request.auth.uid;
      allow update: if isStudent()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /notes/{id} {
      allow create: if isStudent()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility in ['private', 'group', 'public'];
      allow read: if canReadStudyDoc(resource.data);
      allow update, delete: if isStudent()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /materials/{id} {
      allow read: if canReadStudyDoc(resource.data);
      allow create, update, delete: if false; // trusted backend only
    }

    match /groups/{id} {
      allow read: if isStudent() && request.auth.uid in resource.data.memberIds;
      allow create, update, delete: if false; // trusted backend only

      match /projects/{projectId} {
        // Any group member can read projects
        allow read: if isGroupMember(id) || isGroupAdmin(id);

        // Only admins can create, update, or delete projects
        allow create, update, delete: if isGroupAdmin(id);

        match /tasks/{taskId} {
          // Any group member can read tasks
          allow read: if isGroupMember(id) || isGroupAdmin(id);

          // Only admins can create or delete tasks
          allow create, delete: if isGroupAdmin(id);

          // Admins or the assigned user can update tasks (toggle complete, reassign, set reminder)
          allow update: if isStudent() && (
            isGroupAdmin(id)
            || resource.data.assigneeId == request.auth.uid
          );
        }
      }

      // Phase 7: Ziku group quizzes. The answer key lives in the quiz doc
      // and attempts are graded by the trusted backend (admin SDK bypasses
      // these rules), so clients read quizzes only through the API —
      // never directly, where the "correct" field would leak.
      match /quizzes/{quizId} {
        allow read, write: if false;
        match /attempts/{attemptId} {
          allow read, write: if false;
        }
      }
    }

    // ---------------- PHASE 7 — ZIKU LEARNING COMMUNITY ----------------

    // Learning posts (Question Bank + learning kinds). Writes are backend-
    // only because AI tagging, duplicate detection and Learning Points
    // must be trusted; reads respect the group boundary for group posts.
    match /community_posts/{postId} {
      allow read: if isStudent() && (
        !(resource.data.groupId is string)
        || resource.data.groupId == ''
        || isGroupMember(resource.data.groupId)
      );
      allow create, update, delete: if false;

      match /answers/{answerId} {
        allow read: if isStudent() && (
          !(get(/databases/$(database)/documents/community_posts/$(postId)).data.groupId is string)
          || get(/databases/$(database)/documents/community_posts/$(postId)).data.groupId == ''
          || isGroupMember(get(/databases/$(database)/documents/community_posts/$(postId)).data.groupId)
        );
        allow create, update, delete: if false;
      }
    }

    // Learning Points — readable by any student for the leaderboard,
    // writable only by the trusted backend so points cannot be granted.
    match /community_reputation/{uid} {
      allow read: if isStudent();
      allow create, update, delete: if false;
    }

    // Exam challenges — participants only, and even they go through the
    // API so the answer key never reaches a client.
    match /community_challenges/{challengeId} {
      allow read, write: if false;
    }

    // Phase 11: AI community intelligence caches. Existing groups,
    // community_posts, community_reputation and community_challenges remain
    // the source of truth; these derived collections are backend-only.
    match /group_insights/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create, update, delete: if false;
    }

    match /study_groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create, update, delete: if false;
    }

    match /group_members/{memberId} {
      allow read: if isStudent() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /learning_points/{uid} {
      allow read: if isStudent();
      allow create, update, delete: if false;
    }

    match /exam_challenges/{challengeId} {
      allow read, write: if false;
    }

    // Family links (spec 7.7 architecture) — API-only; a parent view will
    // exist in a later phase behind its own permission check.
    match /family_links/{linkId} {
      allow read, write: if false;
    }

    // ---------------- STUDENT + GENERAL PERSONAL DATA ----------------

    match /tasks/{id} {
      allow create: if ownedCreate();
      allow read, delete: if ownedReadDelete();
      // PART 3: owner can flip `completed` and `completedAt` without rewriting
      // ownerId (ownedUpdate already enforces ownerId immutability).
      allow update: if ownedUpdate();
    }

    // PART 3: group chat messages. Membership is mandatory; chatEnabled is a
    // write gate controlled by the group admin via the trusted backend.
    match /group_messages/{msgId} {
      allow read: if isGroupMember(resource.data.groupId);

      allow create: if isStudent()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.groupId is string
        && isGroupMember(request.resource.data.groupId)
        && groupHasChatEnabled(request.resource.data.groupId);

      // Author can delete their own message; admin can delete any in their group.
      allow delete: if isStudent()
        && (resource.data.senderId == request.auth.uid
            || isGroupAdmin(resource.data.groupId));

      // Edits are not part of the product surface.
      allow update: if false;
    }

    match /medicines/{id} {
      allow create: if ownedCreate();
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate();
    }

    match /medicine_doses/{id} {
      allow create: if ownedCreate()
        && request.resource.data.status in ['pending', 'taken', 'skipped', 'missed'];
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate()
        && request.resource.data.status in ['pending', 'taken', 'skipped', 'missed'];
    }

    match /bazar_items/{id} {
      allow create: if ownedCreate();
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate();
    }

    match /daily_expenses/{id} {
      allow create: if ownedCreate() && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
    }

    match /commute_trips/{id} {
      allow create: if ownedCreate()
        && request.resource.data.actualFare is number
        && request.resource.data.actualFare > 0;
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate()
        && request.resource.data.actualFare is number
        && request.resource.data.actualFare > 0;
    }

    match /planned_commute_trips/{id} {
      allow create: if ownedCreate();
      allow read, delete: if ownedReadDelete();
      allow update: if ownedUpdate();
    }

    // Central expense ledger. IDs are deterministic by source + sourceRecordId.
    match /financial_transactions/{id} {
      allow create: if verified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type == 'expense'
        && request.resource.data.source in ['daily', 'bazar', 'medicine', 'commute', 'dena_paid', 'pawna_received']
        && request.resource.data.sourceRecordId is string
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;

      allow read: if verified() && resource.data.ownerId == request.auth.uid;

      // Deleting a mirror row that was never written must be a no-op, not a
      // denial. A bazar item added but not yet purchased, and a dose marked
      // skipped or missed, both clear a mirror row that may never have
      // existed -- and because that delete rides in the same batch as the
      // item write, a denial here rejected the *whole batch*. The student
      // could not add an unpurchased item or skip a dose at all, and the
      // failure surfaced as "You do not have access to this item".
      //
      // Permitting a delete when `resource == null` grants nothing: there is
      // no document to remove and no data to read.
      allow delete: if verified()
        && (resource == null || resource.data.ownerId == request.auth.uid);

      allow update: if verified()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == 'expense'
        && request.resource.data.source in ['daily', 'bazar', 'medicine', 'commute', 'dena_paid', 'pawna_received']
        && request.resource.data.sourceRecordId == resource.data.sourceRecordId
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;
    }

    // Dena/Pawna (lending/borrowing) — owner-only CRUD.
    // Settlements are stored inline in the document; no subcollection needed.
    match /dena_pawna_items/{id} {
      allow create: if verified()
        && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if verified()
        && resource.data.ownerId == request.auth.uid;
      allow update: if verified()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    // Backend-only metering/moderation.
    match /ai_usage/{id} {
      allow read, write: if false;
    }

    match /ai_usage_monthly/{id} {
      allow read, write: if false;
    }

    match /ai_usage_active/{id} {
      allow read, write: if false;
    }

    match /upload_usage/{id} {
      allow read, write: if false;
    }

    match /reports/{id} {
      allow read, write: if false;
    }

    // Legacy LifeHub/finance collections (FamilyHub/RentMate/Wellness/old grocery/location/savings
    // stores) intentionally have no match rules and are therefore denied.
    // Note: dena_pawna_items is NOT legacy — it has explicit rules above.
  }
}
