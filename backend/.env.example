APP_ENV=development
CORS_ORIGINS=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=ekthikana-files

# Phase 2: PostgreSQL connection URL (e.g. postgresql+psycopg2://USER:PASS@HOST:5432/ekthikana)
# When unset the backend falls back to in-memory SQLite for tests/local dev.
DATABASE_URL=
# Private file storage: Backblaze B2 (S3-compatible API). The bucket MUST be
# created as private - a public B2 bucket hands out permanent unauthenticated
# URLs and would bypass the per-request ownership checks.
B2_BUCKET_NAME=
B2_ENDPOINT_URL=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=

# GROQ (primary AI provider — OpenAI-compatible API).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Gemini (fallback when GROQ is unavailable).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (emergency fallback when both GROQ and Gemini are unavailable).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

MAX_UPLOAD_MB=15
USER_STORAGE_LIMIT_MB=100
UPLOAD_DAILY_LIMIT=10
# Spec §8.10: signed download/view URLs must expire in 15 minutes or less.
SIGNED_URL_TTL_SECONDS=900
AI_DAILY_LIMIT=30

# Phase 3A: Per-feature AI usage limits
AI_LIMIT_CHAT_DAILY=20
AI_LIMIT_NOTE_MONTHLY=5
AI_LIMIT_QUIZ_MONTHLY=3
AI_LIMIT_STUDY_PLAN_ACTIVE=1

ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
ROUTING_USER_AGENT=Gochano/1.0 (support@example.com)
COMMUTE_ML_MIN_TOTAL_REPORTS=500
COMMUTE_ML_MIN_MODE_REPORTS=150
