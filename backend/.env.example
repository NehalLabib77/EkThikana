APP_ENV=development
CORS_ORIGINS=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=ekthikana-files

# Phase 2: PostgreSQL connection URL (e.g. postgresql+psycopg2://USER:PASS@HOST:5432/ekthikana)
# When unset the backend falls back to in-memory SQLite for tests/local dev.
DATABASE_URL=
# Phase 2: Firebase Storage bucket name (e.g. ekthikana-files.appspot.com).
FIREBASE_STORAGE_BUCKET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

MAX_UPLOAD_MB=15
USER_STORAGE_LIMIT_MB=100
UPLOAD_DAILY_LIMIT=10
# Spec §8.10: signed download/view URLs must expire in 15 minutes or less.
SIGNED_URL_TTL_SECONDS=900
AI_DAILY_LIMIT=30

ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
ROUTING_USER_AGENT=Gochano/1.0 (support@example.com)
COMMUTE_ML_MIN_TOTAL_REPORTS=500
COMMUTE_ML_MIN_MODE_REPORTS=150
